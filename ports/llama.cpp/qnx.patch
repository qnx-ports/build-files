diff --git a/ggml/src/ggml-cpu/ggml-cpu.cpp b/ggml/src/ggml-cpu/ggml-cpu.cpp
index b7e35d1..a2a01cb 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.cpp
+++ b/ggml/src/ggml-cpu/ggml-cpu.cpp
@@ -8,6 +8,12 @@
 
 #include <cctype>
 #include <string>
+
+#if defined(__QNX__)
+#include <cstring>
+#include <sys/stat.h>
+#include <sys/syspage.h>
+#endif
 #include <vector>
 
 #ifdef GGML_USE_CPU_HBM
@@ -369,6 +375,21 @@ static void ggml_backend_cpu_device_get_memory(ggml_backend_dev_t dev, size_t *
     GlobalMemoryStatusEx(&status);
     *total = status.ullTotalPhys;
     *free = status.ullAvailPhys;
+#elif defined(__QNX__)
+    // QNX has no _SC_PHYS_PAGES: total RAM is the sum of the "ram" entries in the system page,
+    // and the size reported for /proc is the currently free memory.
+    uint64_t ram = 0;
+    const struct asinfo_entry * as = SYSPAGE_ENTRY(asinfo);
+    const size_t n_as = _syspage_ptr->asinfo.entry_size / sizeof(*as);
+    const char * strings = SYSPAGE_ENTRY(strings)->data;
+    for (size_t i = 0; i < n_as; i++) {
+        if (strcmp(strings + as[i].name, "ram") == 0) {
+            ram += as[i].end - as[i].start + 1;
+        }
+    }
+    *total = (size_t) ram;
+    struct stat st;
+    *free = (stat("/proc", &st) == 0 && st.st_size > 0) ? (size_t) st.st_size : *total;
 #else
     long pages = sysconf(_SC_PHYS_PAGES);
     long page_size = sysconf(_SC_PAGE_SIZE);
diff --git a/tools/quantize/quantize.cpp b/tools/quantize/quantize.cpp
index d586951..deca342 100644
--- a/tools/quantize/quantize.cpp
+++ b/tools/quantize/quantize.cpp
@@ -927,7 +927,11 @@ int llama_quantize(int argc, char ** argv) {
         struct sigaction sigint_action;
         sigint_action.sa_handler = signal_handler;
         sigemptyset(&sigint_action.sa_mask);
+#ifdef SA_RESTART
         sigint_action.sa_flags = SA_RESTART;
+#else
+        sigint_action.sa_flags = 0; // e.g. QNX 8.0 does not support SA_RESTART
+#endif
         sigaction(SIGINT, &sigint_action, nullptr);
         sigaction(SIGTERM, &sigint_action, nullptr);
 #elif defined (_WIN32)
